# Smart Attendance System - Backend Environment Configuration Template
# Copy this file to .env and set your environment-specific values.

# Application Environment Mode ('development' or 'production')
ENVIRONMENT=development

# MongoDB Connection Settings
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=smart_attendance

# Frontend Application URL & Allowed CORS Origins (comma-separated)
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication Secret Key (Required: Change to a strong random key in production)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting & Abuse Protection (Requests per IP per minute)
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_FACE_PER_MINUTE=20
RATE_LIMIT_REPORT_PER_MINUTE=10

# File Storage & Audit Retention
REPORTS_DIR=reports_storage
AUDIT_LOG_RETENTION_DAYS=365

# Face Recognition Parameters & Thresholds
FACE_MATCH_THRESHOLD=0.50
FACE_MIN_DETECTION_CONFIDENCE=0.50
FACE_MIN_SIZE_PX=80
FACE_BLUR_THRESHOLD=80.0
FACE_BRIGHTNESS_MIN=40.0
FACE_BRIGHTNESS_MAX=240.0
FACE_MAX_UPLOAD_SIZE_MB=5
